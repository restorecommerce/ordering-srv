{
  "name": "@restorecommerce/ordering-srv",
  "version": "0.5.0",
  "description": "Restore Commerce microservice for managing orders",
  "main": "./dist/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/ordering-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "ordering",
    "srv"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.2.3",
    "@restorecommerce/chassis-srv": "^1.9.3",
    "@restorecommerce/grpc-client": "^2.3.3",
    "@restorecommerce/kafka-client": "^1.4.3",
    "@restorecommerce/logger": "^1.4.3",
    "@restorecommerce/rc-grpc-clients": "^5.2.3",
    "@restorecommerce/resource-base-interface": "^1.10.3",
    "@restorecommerce/service-config": "^1.2.3",
    "bignumber.js": "^11.1.5",
    "csv-parse": "^7.0.2",
    "redis": "6.2.0",
    "remeda": "^2.39.0"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.2",
    "@restorecommerce/protos": "^6.16.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "async-mutex": "^0.5.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node dist/start.cjs",
    "dev": "cross-env NODE_ENV=development node dist/start.cjs",
    "pretest": "eslint src --fix",
    "test": "vitest run",
    "prebuild": "rimraf dist lib coverage",
    "build": "node esbuild.mjs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/ordering-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/ordering-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
