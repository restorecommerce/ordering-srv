{
  "name": "@restorecommerce/ordering-srv",
  "version": "0.5.0",
  "description": "Restore Commerce microservice for managing orders",
  "main": "./dist/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/ordering-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "ordering",
    "srv"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.2.2",
    "@restorecommerce/chassis-srv": "^1.9.2",
    "@restorecommerce/grpc-client": "^2.3.2",
    "@restorecommerce/kafka-client": "^1.4.2",
    "@restorecommerce/logger": "^1.4.2",
    "@restorecommerce/rc-grpc-clients": "^5.2.2",
    "@restorecommerce/resource-base-interface": "^1.10.2",
    "@restorecommerce/service-config": "^1.2.2",
    "bignumber.js": "^11.1.5",
    "csv-parse": "^7.0.1",
    "redis": "6.1.0",
    "remeda": "^2.39.0"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.1",
    "@restorecommerce/protos": "^6.16.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/nconf": "^0.10.7",
    "@types/node": "^26.1.1",
    "async-mutex": "^0.5.0",
    "c8": "^11.0.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node lib/start.cjs",
    "dev": "cross-env NODE_ENV=development nodemon --watch './src/**/*.ts' --exec node --loader ts-node/esm ./src/start.ts",
    "test": "npm run lint && vitest run",
    "lcov-report": "c8 report --reporter=lcov",
    "lint": "eslint src --fix",
    "mocha": "cross-env NODE_ENV=test mocha --full-trace --exit --trace-warnings --exit",
    "test-debug": "cross-env NODE_ENV=test mocha --full-trace --exit --trace-warnings --exit --inspect-brk",
    "build:es": "node esbuild.mjs",
    "build:clean": "rimraf lib dist",
    "build": "npm-run-all build:clean build:es",
    "postbuild": "cp node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 20.8.0"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/ordering-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/ordering-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
